# Kopieren nach .env und ausfüllen. .env wird nie committet.

# Öffentliche Adresse des Servers (mit https://, ohne / am Ende).
# Lokal zum Testen: http://localhost:8888
PUBLIC_URL=https://songs.example.com
PORT=8888

# Deine Twitch-App (https://dev.twitch.tv/console/apps):
#   OAuth-Redirect-URL: <PUBLIC_URL>/callback/twitch   Kategorie: Chat Bot   Client-Typ: Vertraulich
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Zufälliger, langer Schlüssel: verschlüsselt alle gespeicherten Tokens und Secrets.
# Erzeugen z. B. mit:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# NICHT ändern, sonst lassen sich die gespeicherten Daten nicht mehr lesen.
SECRET_KEY=

# Twitch-Namen, die die Admin-Seite (/admin) sehen und den Bot-Account verbinden dürfen
ADMIN_TWITCH_LOGINS=whestone

# Optional
# DATA_DIR=data
# MAX_MEMBERS_PER_ROOM=5
# MAX_ROOMS_PER_USER=3
